.env
git-auto.sh

# [Id]
logs
# Exception: Allow [Id] module in ELD
!src/modules/ELD/[Id]
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Documentation files (internal only, not for git)
# Ignore all .md files except root README.md
**/*.md
!/README.md
