VITE_APP_BASE_URL=http://localhost:7000
BASE_URL_CHAT=wss://ai.routeeld.uz
# Dispatcher agent (eld-logistic-agent) WebSocket, run with BACKEND_API_STYLE=route_eld against this backend.
# Leave empty to hide the "Dispatcher agent" chat on the AI page.
# VITE_APP_AI_AGENT_WS_URL=wss://hos-ai.example.com
BASE_URL_BACKUP=https://new.routeeld.uz
# FUEL_BASE_URL=https://fuel.routeeld.uz

# Self-hosted map data (PMTiles + fonts/sprites). Optional; defaults to ${VITE_APP_BASE_URL}/map-data
# VITE_MAP_DATA_URL=http://localhost:7000/map-data

# Map type imagery. Leave empty to hide the option in the map type menu.
VITE_MAP_SATELLITE_TILES_URL=https://basemap.nationalmap.gov/arcgis/rest/services/USGSImageryOnly/MapServer/tile/{z}/{y}/{x}
VITE_MAP_TERRAIN_DEM_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
